# Create a key at https://console.typesafe.ai/keys
# Leave empty to run in mock mode (fake answers, no API calls).
# Production uses a Pages secret instead: `wrangler pages secret put TYPESAFE_API_KEY`
TYPESAFE_API_KEY=

# Public Turnstile sitekey that scripts/deploy.sh bakes into the production build (see docs/deploy.md).
# Local dev leaves the human check off; scripts/dev-challenge.sh turns it on with Cloudflare's test keys.
VITE_TURNSTILE_SITE_KEY=

# Cloudflare account id for scripts/deploy.sh and pnpm spend (`wrangler whoami` shows it).
# Both refuse to run without it and never touch any other account.
CLOUDFLARE_ACCOUNT_ID=
# Production KV namespace (RULINGS) and D1 database ids. scripts/cloudflare-config.mjs puts them into
# the gitignored apps/web/wrangler.production.jsonc; the committed wrangler.jsonc keeps placeholders.
CLOUDFLARE_KV_RULINGS_ID=
CLOUDFLARE_D1_DATABASE_ID=
